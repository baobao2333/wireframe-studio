    "grapesjs": "0.23.6",
    "grapesjs-plugin-forms": "^2.0.6",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "lucide-static": "^1.44.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
