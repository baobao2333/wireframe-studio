{
  "name": "wireframe-studio",
  "version": "1.0.2",
  "private": true,
  "description": "Desktop wireframe editor with local Codex vision, reusable components and verified updates",
  "author": "baobao2333",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/baobao2333/wireframe-studio.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "predev": "node scripts/prepare-ocr.mjs",
    "dev": "npm run build && node scripts/run-desktop.mjs",
    "dev:web": "vinext dev --port 5187",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "build": "vite build --config vite.desktop.config.ts",
    "package": "npm run build && node scripts/package-desktop.mjs",
    "start": "node scripts/run-desktop.mjs",
    "test": "node scripts/test-core.mjs && node scripts/test-editor.mjs && node scripts/test-hot-update.mjs && node scripts/test-desktop-services.mjs",
    "pretest:desktop": "node scripts/prepare-ocr.mjs",
    "test:desktop": "node scripts/test-ocr-worker.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
